# Career Radar 환경변수 (이름만, 실제 값은 .env.local에)

# AI 분석·비교 (서버 전용)
OPENROUTER_API_KEY=

# Supabase Auth (브라우저에 노출되는 공개 값만: 프로젝트 URL + publishable key)
# service-role / secret key는 사용하지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 저장 API(POST/DELETE)를 추가로 허용할 origin (서버 전용, 선택)
# 브라우저가 접속한 주소와 같은 출처는 설정 없이 허용됩니다. 그 밖의 주소만 쉼표로 구분해 적습니다.
# origin 형식(scheme://host[:port], 경로 없음). "*" 전체 허용은 지원하지 않습니다.
# 예: APP_ALLOWED_ORIGINS=http://localhost:3016,http://localhost:18016,https://<사이트>.netlify.app
APP_ALLOWED_ORIGINS=
